# Copy to .env and change both values before the first run.

# The password for the IT admin sign-in. Anything long and unguessable.
ADMIN_PASSWORD=change-me

# Signs the session cookies. Changing it signs everyone out, which is the
# fastest way to end every session at once.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-32-random-bytes

# Where the SQLite file lives. Back this file up: it holds every correction.
DATABASE_PATH=./register.db

PORT=3000

# Set to 1 when the app is served over HTTPS, so cookies are marked Secure.
# Leave unset while testing over plain http on localhost.
SECURE_COOKIES=
